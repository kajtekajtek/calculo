POSTGRES_PASSWORD=change-me
CALCULO_PASSWORD=change-me
CALCULO_BOND_ACCOUNT_NAME=Obligacje
# Free key from https://eodhd.com (personal use); without it positions are valued at cost
EODHD_API_KEY=
# Optional, defaults shown. XTB ticker suffix to EODHD exchange code; an empty replacement drops the suffix
# CALCULO_SUFFIX_MAP=PL=WAR,DE=XETRA
# EODHD exchange code to the currency of its prices
# CALCULO_EXCHANGE_CURRENCIES=WAR=PLN,XETRA=EUR,US=USD
# Requests to EODHD per UTC day (free plan: 20)
# CALCULO_PRICE_CALL_LIMIT=20
